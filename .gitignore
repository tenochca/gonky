# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Build / packaging ─────────────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
MANIFEST

# ── Installer caches ──────────────────────────────────────────────────────────
pip-log.txt
pip-delete-this-directory.txt
.pip/
wheels/

# ── pytest / coverage ─────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover

# ── mypy / type-checkers ──────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json

# ── Editors / IDEs ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Gonky project files (user data — not tracked in source) ───────────────────
# .gonky save files created during development/testing
*.gonky

# ── Gonky preview cache ───────────────────────────────────────────────────────
# Written by PreviewManager to ~/.cache/gonky/; listed here for local dev safety
.cache/

# ── Conky config exports produced during testing ──────────────────────────────
# Keep the real conky.conf in place — only ignore transient test exports
*.conf.test

# ── OS cruft ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Temporary / log files ─────────────────────────────────────────────────────
*.tmp
*.log
*.bak
